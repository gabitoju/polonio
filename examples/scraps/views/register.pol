<h1>Register</h1><% if form_error != null %><p class="error"><% echo html_escape(form_error) %></p><% end %><form method="post" action="<% echo route_url("register") %>"><input type="hidden" name="csrf" value="<% echo csrf_token() %>"><label>Username <input name="username" value="<% echo html_escape(form_username) %>"></label><label>Email <input name="email" value="<% echo html_escape(form_email) %>"></label><label>Password <input type="password" name="password"></label><button>Register</button></form>
