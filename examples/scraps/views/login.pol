<h1>Log in</h1><% if form_error != null %><p class="error"><% echo html_escape(form_error) %></p><% end %><form method="post" action="<% echo route_url("login") %>"><input type="hidden" name="csrf" value="<% echo csrf_token() %>"><label>Username <input name="username" value="<% echo html_escape(form_username) %>"></label><label>Password <input type="password" name="password"></label><button>Log in</button></form>
