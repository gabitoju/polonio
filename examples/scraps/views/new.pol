<h1>Publish a scrap</h1><% if form_error != null %><p class="error"><% echo html_escape(form_error) %></p><% end %><form method="post" action="<% echo route_url("publish") %>"><input type="hidden" name="csrf" value="<% echo csrf_token() %>"><label>Name <input name="name" value="<% echo html_escape(form_name) %>"></label><label>Content <textarea name="content"><% echo html_escape(form_content) %></textarea></label><button>Publish</button></form>
