<!doctype html><html lang="en"><head><meta charset="utf-8"><title><% echo html_escape(page_title) %> — Scraps</title><style>body{max-width:48rem;margin:2rem auto;font:16px system-ui,sans-serif;padding:0 1rem}nav{display:flex;gap:.7rem;align-items:center}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem;background:#f5f5f5}label{display:block;margin:.6rem 0}input,textarea{width:100%;box-sizing:border-box}textarea{min-height:12rem}.error{color:#a00}</style></head><body><nav><a href="/scraps/">Scraps</a>
<% if viewer != null %><span>Signed in as <% echo html_escape(viewer["username"]) %></span><a href="<% echo route_url("new") %>">New scrap</a><form method="post" action="<% echo route_url("logout") %>"><input type="hidden" name="csrf" value="<% echo csrf_token() %>"><button>Log out</button></form><% else %><a href="<% echo route_url("register") %>">Register</a><a href="<% echo route_url("login") %>">Log in</a><% end %></nav><main>
